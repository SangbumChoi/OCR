.venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
outputs/
artifacts/
# Per-run eval outputs: ignore by default, but COMMIT (a) the reference tables/matrices at the top
# level and (b) the resume state (predictions.jsonl / summary.json at any depth), so a GPU-limited
# run can be checkpointed to git and resumed after the container resets (scripts/run_checkpointed.sh).
docs/results/**
!docs/results/**/
!docs/results/*.md
!docs/results/*.json
!docs/results/**/predictions.jsonl
!docs/results/**/summary.json
data/crawled/
wandb/


# pip editable-install build metadata
*.egg-info/
build/
dist/

# Augraphy writes intermediate frames here when generating realistic samples
augraphy_cache/

# Offline benchmark training set: cached images + Arrow dataset (regenerable; lives on HF).
# Build with scripts/build_benchmark_trainset.py; publish via push_to_hub / huggingface-cli upload.
data/benchmark_trainset/

# Unified loader output: cached images + jsonl (regenerable; lives on HF)
data/unified_dataset/

# UDD (Unified Document Dataset) build output: images + per-dataset HF arrow (regenerable; lives on HF)
data/udd/

# Task-value ablation: equal-N per-task training sets (regenerable from UDD via build_task_trainsets.py)
data/udd_tasks/

# A4 language trainsets (regenerable from UDD via build_task_trainsets --group-by language)
data/udd_langs/

# Synthetic UDD-format corpus (LOCAL ONLY, regenerable from make_realistic_cases)
data/udd_synthetic/

# Reading-order probe renders (regenerable via make_reading_order_probe.py)
data/probes/reading_order/
