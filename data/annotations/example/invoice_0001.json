 "understanding": {
  "caption": "A one-page supplier invoice from Hanbit Office Supply Co. listing three office-supply line items, with subtotal, 10% VAT and the total due; the invoice is stamped PAID.",
  "guide": [
   {
    "id": "g1",
    "text": "Each line item's Amount equals Qty x Unit Price; the Subtotal is the sum of the Amount column.",
    "kind": "structure",
    "scope": [
     "tb1",
     "t25"
    ]
   },
   {
    "id": "g2",
    "text": "The date is written DD/MM/YYYY (Korean vendor), so 03/04/2024 is 3 April 2024, not 4 March.",
    "kind": "convention",
    "scope": [
     "t5"
    ]
   },
   {
    "id": "g3",
    "text": "TOTAL DUE already includes VAT (Subtotal + VAT); do not add tax again.",
    "kind": "disambiguation",
    "scope": [
     "t29",
     "t27"
    ]
   },
   {
    "id": "g4",
    "text": "The red PAID stamp is a payment-status mark; it is not part of the vendor block or any field value.",
    "kind": "pitfall",
    "scope": [
     "r6"
    ]
   },
   {
    "id": "g5",
    "text": "'Net 30' means payment is due 30 days after the invoice date.",
    "kind": "domain",
    "scope": [
     "t6",
     "t31"
    ]
   }
  ],
